table fact_bank_quarter
	lineageTag: bd18302b-3d6a-4cc1-898d-45cde2d82f61
	sourceLineageTag: [gold].[fact_bank_quarter]

	measure 'Total Assets' = ```
			
			VAR LastQ = MAX ( fact_bank_quarter[date_key] )          -- latest quarter in the current filter
			RETURN 
			   CALCULATE(SUM(fact_bank_quarter[total_assets] ), 
			                  fact_bank_quarter[date_key] = LastQ)
			```
		lineageTag: 5cdc94c0-8bb6-4646-8865-dab3775fca47

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Deposits' = ```
			
			VAR LastQ = MAX(fact_bank_quarter[date_key])
			RETURN 
			   CALCULATE (SUM(fact_bank_quarter[total_deposits]), 
			                  fact_bank_quarter[date_key] = LastQ )
			```
		lineageTag: 7fe80fcd-4785-4440-b55a-20a655e4634c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Loans' =
			
			VAR LastQ = MAX ( fact_bank_quarter[date_key] )   -- latest quarter in the current filter
			RETURN
			    CALCULATE (
			        SUM ( fact_bank_quarter[net_loans] ),
			        fact_bank_quarter[date_key] = LastQ          -- keep only that quarter
			    )
		lineageTag: 6ea70776-cab5-40fb-83c2-9c64a8422438

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

